{
  "hosting": {
    "site": "gyutto-cb454",
    "public": "support-site",
    "ignore": ["firebase-debug.log", "**/.*"],
    "cleanUrls": true,
    "headers": [
      { "source": "**", "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ] }
    ]
  }
}
