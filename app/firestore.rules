rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /parentInviteCodes/{codeHash} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.type == 'parentInvite'
        && request.resource.data.status == 'active';
      allow update: if signedIn()
        && resource.data.status == 'active'
        && request.resource.data.status == 'used'
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status']);
    }

    match /childInviteTokens/{tokenHash} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.type == 'childQrInvite'
        && request.resource.data.status == 'active';
      allow update: if signedIn()
        && resource.data.status == 'active'
        && request.resource.data.status == 'used'
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status']);
    }

    match /families/{familyId} {
      allow create: if signedIn()
        && request.resource.data.adminUserId == request.auth.uid;

      allow read, update: if signedIn();

      match /members/{memberId} {
        allow create: if signedIn()
          && (
            memberId == request.auth.uid
            || (
              request.resource.data.role == 'child'
              && request.resource.data.createdBy == request.auth.uid
              && request.resource.data.inviteId is string
              && get(
                /databases/$(database)/documents/families/$(familyId)/invites/$(request.resource.data.inviteId)
              ).data.type == 'childQrInvite'
              && get(
                /databases/$(database)/documents/families/$(familyId)/invites/$(request.resource.data.inviteId)
              ).data.status == 'active'
            )
          );
        allow read: if signedIn();
      }

      match /messages/{messageId} {
        allow read, create: if signedIn();
      }

      match /invites/{inviteId} {
        allow read, write: if signedIn();
      }

      match /passwordResetRequests/{requestId} {
        allow read, write: if signedIn();
      }
    }
  }
}
