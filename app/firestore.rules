rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isFamilyMember(familyId) {
      return signedIn()
        && exists(
          /databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)
        )
        && get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.status == 'active';
    }

    // Missing consent records fail closed, including for existing accounts.
    function canUseChat(familyId) {
      let access = get(/databases/$(database)/documents/families/$(familyId)/chatAccess/$(request.auth.uid)).data;
      let role = get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.role;
      return isFamilyMember(familyId)
        && access.safetyVersion == 1
        && ((role == 'child' && access.permission == 'allowed' && access.permissionVersion == 1)
          || (role in ['familyAdmin', 'parent'] && access.adultVersion == 1));
    }

    function validOwnReadReceipt(familyId) {
      let receipt = request.resource.data.readBy[request.auth.uid];
      return receipt is map
        && receipt.keys().hasAll(['displayName', 'readAt'])
        && receipt.keys().hasOnly(['displayName', 'readAt'])
        && receipt.displayName == get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.displayName
        && receipt.readAt == request.time;
    }

    function isFamilyAdmin(familyId) {
      return isFamilyMember(familyId)
        && get(
          /databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)
        ).data.role == 'familyAdmin';
    }

    function canReviewChildJoinRequest(familyId) {
      return isFamilyMember(familyId)
        && get(
          /databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)
        ).data.role in ['familyAdmin', 'parent']
        && get(
          /databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)
        ).data.status == 'active';
    }

    function isCreatingOwnFamilyMembership(familyId, memberId) {
      return signedIn()
        && !exists(/databases/$(database)/documents/families/$(familyId))
        && memberId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.role == 'familyAdmin'
        && request.resource.data.status == 'active'
        && getAfter(
          /databases/$(database)/documents/families/$(familyId)
        ).data.adminUserId == request.auth.uid;
    }

    function isJoiningWithInvite(familyId, memberId) {
      let inviteId = request.resource.data.inviteId;
      return signedIn()
        && memberId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.role == 'parent'
        && inviteId is string
        && isConsumingParentInvite(familyId, inviteId);
    }

    // All three documents must transition together in the same batch/transaction.
    function isConsumingParentInvite(familyId, inviteId) {
      let invitePath = /databases/$(database)/documents/families/$(familyId)/invites/$(inviteId);
      let invite = get(invitePath).data;
      let inviteAfter = getAfter(invitePath).data;
      let codePath = /databases/$(database)/documents/parentInviteCodes/$(invite.codeHash);
      let code = get(codePath).data;
      let codeAfter = getAfter(codePath).data;
      let memberPath = /databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid);
      let memberAfter = getAfter(memberPath).data;
      return signedIn()
        && invite.type == 'parentInvite'
        && invite.targetRole == 'parent'
        && invite.codeHash is string
        && invite.status == 'active'
        && invite.expiresAt is timestamp
        && request.time < invite.expiresAt
        && code.type == 'parentInvite'
        && code.targetRole == 'parent'
        && code.familyId == familyId
        && code.inviteId == inviteId
        && code.status == 'active'
        && code.expiresAt is timestamp
        && code.expiresAt == invite.expiresAt
        && request.time < code.expiresAt
        && inviteAfter.status == 'used'
        && inviteAfter.usedBy == request.auth.uid
        && inviteAfter.diff(invite).affectedKeys().hasOnly(['status', 'usedAt', 'usedBy'])
        && codeAfter.status == 'used'
        && codeAfter.diff(code).affectedKeys().hasOnly(['status'])
        && !exists(memberPath)
        && memberAfter.userId == request.auth.uid
        && memberAfter.role == 'parent'
        && memberAfter.status == 'active'
        && memberAfter.inviteId == inviteId;
    }

    function isConsumingChildInvite(familyId, inviteId, tokenHash) {
      let invitePath = /databases/$(database)/documents/families/$(familyId)/invites/$(inviteId);
      let invite = get(invitePath).data;
      let inviteAfter = getAfter(invitePath).data;
      let tokenPath = /databases/$(database)/documents/childInviteTokens/$(tokenHash);
      let token = get(tokenPath).data;
      let tokenAfter = getAfter(tokenPath).data;
      let joinPath = /databases/$(database)/documents/families/$(familyId)/joinRequests/$(request.auth.uid);
      let joinAfter = getAfter(joinPath).data;
      return signedIn()
        && invite.type == 'childQrInvite'
        && invite.targetRole == 'child'
        && invite.tokenHash == tokenHash
        && invite.status == 'active'
        && invite.expiresAt is timestamp
        && request.time < invite.expiresAt
        && token.type == 'childQrInvite'
        && token.targetRole == 'child'
        && token.familyId == familyId
        && token.inviteId == inviteId
        && token.status == 'active'
        && token.expiresAt is timestamp
        && request.time < token.expiresAt
        && token.expiresAt == invite.expiresAt
        && inviteAfter.status == 'used'
        && inviteAfter.usedBy == request.auth.uid
        && inviteAfter.diff(invite).affectedKeys().hasOnly(['status', 'usedAt', 'usedBy'])
        && tokenAfter.status == 'used'
        && tokenAfter.diff(token).affectedKeys().hasOnly(['status'])
        && !exists(joinPath)
        && joinAfter.userId == request.auth.uid
        && joinAfter.role == 'child'
        && joinAfter.status == 'pending'
        && joinAfter.inviteId == inviteId
        && joinAfter.tokenHash == tokenHash;
    }
    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /parentInviteCodes/{codeHash} {
      allow get: if signedIn();
      allow create: if isFamilyAdmin(request.resource.data.familyId)
        && request.resource.data.type == 'parentInvite'
        && request.resource.data.status == 'active';
      allow update: if signedIn()
        && get(/databases/$(database)/documents/families/$(resource.data.familyId)/invites/$(resource.data.inviteId)).data.codeHash == codeHash
        && isConsumingParentInvite(resource.data.familyId, resource.data.inviteId);
    }

    match /childInviteTokens/{tokenHash} {
      allow get: if signedIn();
      allow create: if canReviewChildJoinRequest(request.resource.data.familyId)
        && request.resource.data.type == 'childQrInvite'
        && request.resource.data.status == 'active';
      allow update: if signedIn()
        && isConsumingChildInvite(resource.data.familyId, resource.data.inviteId, tokenHash);
    }
    match /families/{familyId} {
      allow create: if signedIn()
        && request.resource.data.adminUserId == request.auth.uid;

      allow read: if isFamilyMember(familyId);
      // Changing the owner requires a separate, trusted transfer operation.
      allow update: if canReviewChildJoinRequest(familyId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt']);

      match /members/{memberId} {
        allow create: if signedIn()
          && (
            isCreatingOwnFamilyMembership(familyId, memberId)
            || isJoiningWithInvite(familyId, memberId)
          );
        allow read: if isFamilyMember(familyId) || (signedIn() && request.auth.uid == memberId);
        allow update: if canReviewChildJoinRequest(familyId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'role', 'status', 'updatedAt'])
          && request.resource.data.role in ['familyAdmin', 'parent', 'child']
          && request.resource.data.status in ['active', 'invited', 'disabled', 'suspended']
          && (memberId != get(/databases/$(database)/documents/families/$(familyId)).data.adminUserId
            || (request.resource.data.role == 'familyAdmin' && request.resource.data.status == 'active'));
        allow delete: if canReviewChildJoinRequest(familyId)
          && memberId != get(/databases/$(database)/documents/families/$(familyId)).data.adminUserId;
      }

      match /chatAccess/{userId} {
        allow read: if (signedIn() && request.auth.uid == userId) || canReviewChildJoinRequest(familyId);
        allow write: if false;
      }
      match /chatSafetyEvents/{eventId} {
        allow read: if canReviewChildJoinRequest(familyId);
        allow write: if false;
      }

      match /messages/{messageId} {
        allow read: if canUseChat(familyId);
        allow create: if canUseChat(familyId)
          && get(/databases/$(database)/documents/families/$(familyId)/chatAccess/$(request.auth.uid)).data.postingTermsVersion == 1
          && request.resource.data.keys().hasAll(['senderUserId', 'senderDisplayName', 'text', 'readBy', 'createdAt'])
          && request.resource.data.keys().hasOnly(['senderUserId', 'senderDisplayName', 'text', 'readBy', 'createdAt'])
          && request.resource.data.senderUserId == request.auth.uid
          && request.resource.data.senderDisplayName == get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.displayName
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.createdAt == request.time
          && request.resource.data.readBy is map
          && request.resource.data.readBy.keys().hasOnly([request.auth.uid])
          && validOwnReadReceipt(familyId);
        allow update: if canUseChat(familyId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
          && request.resource.data.readBy is map
          && request.resource.data.readBy.diff(resource.data.readBy).affectedKeys().hasOnly([request.auth.uid])
          && validOwnReadReceipt(familyId);
      }

      match /invites/{inviteId} {
        allow get: if signedIn();
        allow list: if canReviewChildJoinRequest(familyId);
        allow create: if request.resource.data.createdBy == request.auth.uid
          && request.resource.data.status == 'active'
          && ((request.resource.data.type == 'parentInvite'
              && request.resource.data.targetRole == 'parent' && isFamilyAdmin(familyId))
            || (request.resource.data.type == 'childQrInvite'
              && request.resource.data.targetRole == 'child' && canReviewChildJoinRequest(familyId)));
        allow delete: if canReviewChildJoinRequest(familyId);
        allow update: if (
            signedIn()
            && resource.data.type == 'childQrInvite'
            && isConsumingChildInvite(familyId, inviteId, resource.data.tokenHash)
          )
          || (
            signedIn()
            && resource.data.type == 'parentInvite'
            && isConsumingParentInvite(familyId, inviteId)
          );
      }

      match /joinRequests/{userId} {
        allow get: if signedIn()
          && (request.auth.uid == userId || canReviewChildJoinRequest(familyId));
        allow list: if canReviewChildJoinRequest(familyId);
        allow create: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.role == 'child'
          && request.resource.data.status == 'pending'
          && request.resource.data.inviteId is string
          && request.resource.data.tokenHash is string
          && isConsumingChildInvite(familyId, request.resource.data.inviteId, request.resource.data.tokenHash);
        allow update, delete: if false;
      }

      match /passwordResetRequests/{requestId} {
        allow read: if canReviewChildJoinRequest(familyId)
          || (isFamilyMember(familyId) && resource.data.childUserId == request.auth.uid);
        // Approval/status transitions are reserved for trusted server code.
        allow write: if false;
      }
    }
  }
}
