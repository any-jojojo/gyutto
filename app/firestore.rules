rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isFamilyMember(familyId) {
      return signedIn()
        && exists(
          /databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)
        );
    }

    function isFamilyAdmin(familyId) {
      return isFamilyMember(familyId)
        && get(
          /databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)
        ).data.role == 'familyAdmin';
    }

    function isCreatingOwnFamilyMembership(familyId, memberId) {
      return signedIn()
        && memberId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/families/$(familyId)
        ).data.adminUserId == request.auth.uid;
    }

    function isJoiningWithInvite(familyId, memberId) {
      let inviteId = request.resource.data.inviteId;
      return signedIn()
        && memberId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.role == 'parent'
        && inviteId is string
        && isConsumingParentInvite(familyId, inviteId);
    }

    // All three documents must transition together in the same batch/transaction.
    function isConsumingParentInvite(familyId, inviteId) {
      let invitePath = /databases/$(database)/documents/families/$(familyId)/invites/$(inviteId);
      let invite = get(invitePath).data;
      let inviteAfter = getAfter(invitePath).data;
      let codePath = /databases/$(database)/documents/parentInviteCodes/$(invite.codeHash);
      let code = get(codePath).data;
      let codeAfter = getAfter(codePath).data;
      let memberPath = /databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid);
      let memberAfter = getAfter(memberPath).data;
      return signedIn()
        && invite.type == 'parentInvite'
        && invite.targetRole == 'parent'
        && invite.codeHash is string
        && invite.status == 'active'
        && invite.expiresAt is timestamp
        && request.time < invite.expiresAt
        && code.type == 'parentInvite'
        && code.targetRole == 'parent'
        && code.familyId == familyId
        && code.inviteId == inviteId
        && code.status == 'active'
        && code.expiresAt is timestamp
        && code.expiresAt == invite.expiresAt
        && request.time < code.expiresAt
        && inviteAfter.status == 'used'
        && inviteAfter.usedBy == request.auth.uid
        && inviteAfter.diff(invite).affectedKeys().hasOnly(['status', 'usedAt', 'usedBy'])
        && codeAfter.status == 'used'
        && codeAfter.diff(code).affectedKeys().hasOnly(['status'])
        && !exists(memberPath)
        && memberAfter.userId == request.auth.uid
        && memberAfter.role == 'parent'
        && memberAfter.status == 'active'
        && memberAfter.inviteId == inviteId;
    }

    function isConsumingChildInvite(familyId, inviteId, tokenHash) {
      let invitePath = /databases/$(database)/documents/families/$(familyId)/invites/$(inviteId);
      let invite = get(invitePath).data;
      let inviteAfter = getAfter(invitePath).data;
      let tokenPath = /databases/$(database)/documents/childInviteTokens/$(tokenHash);
      let token = get(tokenPath).data;
      let tokenAfter = getAfter(tokenPath).data;
      let joinPath = /databases/$(database)/documents/families/$(familyId)/joinRequests/$(request.auth.uid);
      let joinAfter = getAfter(joinPath).data;
      return signedIn()
        && invite.type == 'childQrInvite'
        && invite.targetRole == 'child'
        && invite.tokenHash == tokenHash
        && invite.status == 'active'
        && invite.expiresAt is timestamp
        && request.time < invite.expiresAt
        && token.type == 'childQrInvite'
        && token.targetRole == 'child'
        && token.familyId == familyId
        && token.inviteId == inviteId
        && token.status == 'active'
        && token.expiresAt is timestamp
        && request.time < token.expiresAt
        && token.expiresAt == invite.expiresAt
        && inviteAfter.status == 'used'
        && inviteAfter.usedBy == request.auth.uid
        && inviteAfter.diff(invite).affectedKeys().hasOnly(['status', 'usedAt', 'usedBy'])
        && tokenAfter.status == 'used'
        && tokenAfter.diff(token).affectedKeys().hasOnly(['status'])
        && !exists(joinPath)
        && joinAfter.userId == request.auth.uid
        && joinAfter.role == 'child'
        && joinAfter.status == 'pending'
        && joinAfter.inviteId == inviteId
        && joinAfter.tokenHash == tokenHash;
    }
    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /parentInviteCodes/{codeHash} {
      allow get: if signedIn();
      allow create: if isFamilyMember(request.resource.data.familyId)
        && request.resource.data.type == 'parentInvite'
        && request.resource.data.status == 'active';
      allow update: if signedIn()
        && get(/databases/$(database)/documents/families/$(resource.data.familyId)/invites/$(resource.data.inviteId)).data.codeHash == codeHash
        && isConsumingParentInvite(resource.data.familyId, resource.data.inviteId);
    }

    match /childInviteTokens/{tokenHash} {
      allow get: if signedIn();
      allow create: if isFamilyMember(request.resource.data.familyId)
        && request.resource.data.type == 'childQrInvite'
        && request.resource.data.status == 'active';
      allow update: if signedIn()
        && isConsumingChildInvite(resource.data.familyId, resource.data.inviteId, tokenHash);
    }
    match /families/{familyId} {
      allow create: if signedIn()
        && request.resource.data.adminUserId == request.auth.uid;

      allow read, update: if isFamilyMember(familyId);

      match /members/{memberId} {
        allow create: if signedIn()
          && (
            isCreatingOwnFamilyMembership(familyId, memberId)
            || isJoiningWithInvite(familyId, memberId)
          );
        allow read: if isFamilyMember(familyId);
        allow update, delete: if isFamilyMember(familyId);
      }

      match /messages/{messageId} {
        allow read, create: if isFamilyMember(familyId);
        allow update: if isFamilyMember(familyId)
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['readBy'])
          && request.resource.data.readBy.diff(resource.data.readBy).affectedKeys().hasOnly([request.auth.uid]);
      }

      match /invites/{inviteId} {
        allow get: if signedIn();
        allow list, create, delete: if isFamilyMember(familyId);
        allow update: if (
            signedIn()
            && resource.data.type == 'childQrInvite'
            && isConsumingChildInvite(familyId, inviteId, resource.data.tokenHash)
          )
          || (
            signedIn()
            && resource.data.type == 'parentInvite'
            && isConsumingParentInvite(familyId, inviteId)
          );
      }

      match /joinRequests/{userId} {
        allow get: if signedIn()
          && (request.auth.uid == userId || isFamilyAdmin(familyId));
        allow list: if isFamilyAdmin(familyId);
        allow create: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.role == 'child'
          && request.resource.data.status == 'pending'
          && request.resource.data.inviteId is string
          && request.resource.data.tokenHash is string
          && isConsumingChildInvite(familyId, request.resource.data.inviteId, request.resource.data.tokenHash);
        allow update, delete: if false;
      }

      match /passwordResetRequests/{requestId} {
        allow read, write: if signedIn();
      }
    }
  }
}
